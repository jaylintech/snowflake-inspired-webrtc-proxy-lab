# Copy to testbed/.env and replace every CHANGE_ME value.
COTURN_IMAGE=coturn/coturn:4.12.0
MITMPROXY_IMAGE=mitmproxy/mitmproxy:12.2.3
SURICATA_IMAGE=jasonish/suricata:8.0.5
ZEEK_IMAGE=zeek/zeek:8.0.8

TURN_REALM=turn.lab.example
# For a two-host run, bind published ports to the owned LAN interface.
TURN_BIND_IP=127.0.0.1
# Reachable IPv4 address Coturn advertises in relay candidates.
TURN_EXTERNAL_IP=CHANGE_ME
TURN_TLS_HOST_PORT=443
TURN_USERNAME=CHANGE_ME
TURN_PASSWORD=CHANGE_ME

# Coturn denies every other IPv4/IPv6 relay destination. Set this to the
# permitted remote relay-candidate IP or range. If both forced-relay peers use
# this TURN server, this is normally the TURN_EXTERNAL_IP value.
TURN_ALLOWED_PEER_IP=CHANGE_ME

# Host path containing turn-cert.pem and turn-key.pem. This directory is ignored.
TURN_CERT_DIR=./private/turn

# Bind the explicit TLS-inspection proxy to loopback on this host.
MITMPROXY_HOST_PORT=8081
